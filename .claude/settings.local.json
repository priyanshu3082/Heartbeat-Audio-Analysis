{
  "permissions": {
    "allow": [
      "Bash(npm run:*)",
      "Bash(kill 7108 28472 30336)",
      "Bash(netstat -ano)",
      "Bash(cmd /c \"taskkill /PID 7108 /F & taskkill /PID 28472 /F & taskkill /PID 30336 /F\")",
      "Bash(cmd /c \"taskkill /IM node.exe /F\")",
      "Bash(powershell -Command \"Stop-Process -Id 7108,28472,30336 -Force -ErrorAction SilentlyContinue; Write-Output ''done''\")",
      "Bash(powershell -Command \"Get-Process node -ErrorAction SilentlyContinue | Stop-Process -Force; Write-Output ''All node killed''\")",
      "Bash(curl -s -m 60 -o /dev/null -w \"%{http_code}\" http://localhost:3000/)"
    ]
  }
}
